# ============================================================
# EduFlow Backend — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Database ----------
# Local dev (PostgreSQL 18 on this machine)
DATABASE_URL="postgresql://postgres:<PASSWORD>@localhost:5432/eduflow"

# ---------- Server ----------
PORT=3001
NODE_ENV=development
# Set to true when running behind a reverse proxy (nginx) so client IPs are real
TRUST_PROXY=false
# Clock used by scheduled jobs (e.g. the 09:00 debt reminder)
APP_TIMEZONE=Asia/Tashkent

# ---------- JWT ----------
# Generate strong values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_KEY=<RANDOM_64_CHAR_HEX>
REFRESH_TOKEN_KEY=<RANDOM_64_CHAR_HEX_DIFFERENT_FROM_ABOVE>
ACCESS_TOKEN_TIME=15m
REFRESH_TOKEN_TIME=7d
COOKIE_TIME=604800000

# ---------- CORS ----------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Telegram bot (OTP + notifications) ----------
TELEGRAM_BOT_TOKEN=<BOT_TOKEN_FROM_BOTFATHER>

# ---------- Mail (optional) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<SMTP_USER>
MAIL_PASS=<SMTP_APP_PASSWORD>
MAIL_FROM=<FROM_ADDRESS>

# ---------- Platform bootstrap (POST /api/auth/init) ----------
SUPER_ADMIN_PHONE=998001112233
SUPER_ADMIN_PASSWORD=<STRONG_PASSWORD>

# ---------- AI assistant (optional, off by default) ----------
# Put your own key here first, then set AI_CHAT_ENABLED=true.
# Free keys: https://console.groq.com/keys
AI_CHAT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high: how long gpt-oss models think before answering
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=30000
# Messages each user may send, so one person cannot use up the free allowance
AI_MINUTE_LIMIT=5
AI_DAILY_LIMIT=30
